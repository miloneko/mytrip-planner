<div class="flex object-center justify-center font-serif tems-center w-full bg-white">
  <div class="w-full bg-white rounded shadow-2xl p-8 m-4">
    <h1 class="block w-full text-center text-gray-800 text-2xl font-bold mb-6">地域、ハッシュタグで絞り込み検索</h1>
<%= search_form_for @q, url: search_posts_path do |f| %>
 <main class='container mx-auto w-1/3'>
 <div class=" object-center bg-gray-50 border focus:ring ring-red-50 rounded outline-none transition duration-100 px-3 py-2 text-center px-32 mb-4">
  <%= f.collection_select :location_id_eq, Location.where.not(id: 0), :id, :name, include_blank: "地域を選択してください"%>
 </div>
 </main>
  <%= f.label :categories_id_eq_any, "Hashtag検索" %>
  <% Category.all.each do |category| %>
     <%= check_box_tag('q[categories_id_eq_any][]', category.id ) %>
     <%= category.name %>
  <% end %>
<div>
<main class='container mx-auto flex justify-center'>
  <%= f.submit '検索',class:"object-center border-2 border-gray-600 text-black px-4 py-2 rounded-md text-1xl font-medium hover:bg-gray-600 transition duration-300 mt-4" %>
</main>
</div>
<% end %>
<div class="rounded overflow-hidden shadow-lg">
  <div class="container rounded-t-md px-24 py-24 mx-auto">
    <div class="flex flex-col text-center mb-30">
      <div class="flex flex-wrap sm:-m-3 -mx-4 -mb-10 -mt-4">
        <% if @posts.present? %>
          <%= render @posts %>
        <% else %>
      <p>まだ投稿がありません</p>
        <% end %>
      </div>
    </div>
  </div>
  <section><%= paginate @posts %></section>
  <div id="display">ピンをクリックすると、投稿された観光地が表示されます！ウィンドウをクリックすると投稿詳細ページに飛びます！</div>
  <div id='map'></div>
 <% if logged_in? %>
<div class="posts_modal js-modal">
  <div class="posts_modalbg">
  <div class="posts_modalcontent">
    <div class="justify-center border-t border-gray-200">
      <h2 class="text-2xl font-bold text-center item-center"><%= current_user.name %>さんにおすすめの観光地</h2>
    </div>
    <div class="container rounded-t-md px-24 py-24 mx-auto">
      <div class="flex flex-col text-center mb-30">
        <div class="flex flex-wrap sm:-m-3 -mx-4 -mb-10 -mt-4">
            <% if @recommendposts.present? %>
              <% @recommendposts.each do |recpost| %>
                <div class="rounded overflow-hidden border w-full lg:w-4/12 md:w-6/12 bg-white mx-3 md:mx-0 lg:mx-0">
                  <div class="w-full flex justify-between p-3">
                    <div class="flex">
                      <div class="rounded-full h-8 w-8 bg-gray-500 flex items-center justify-center overflow-hidden">
                        <%= image_tag recpost.user.avatar_url, size: '300x200' %>
                      </div>
                      <span class="pt-1 ml-2 font-bold text-sm"><%= recpost.user.name %></span>
                    </div>    
                    <span class="px-2 hover:bg-gray-300 cursor-pointer rounded"><%= link_to post_path(recpost) do%><i class="fas fa-ellipsis-h pt-2 text-lg"></i></span><% end %>
                  </div>
                  <div class="w-full bg-cover">
                    <%= image_tag recpost.image_url(:thumb), size: '400x400' %>
                  </div>
                  <div class="px-3 pb-2">
                      <% if logged_in? %>
                        <%= render 'like_button', { post: recpost } %>
                      <% else %>
                        <%= render 'nonlogin' %>
                      <% end %>
                      <div class="pt-1">
                        <div class="mb-2 text-sm">
                          <span class="font-medium mr-2"><%= link_to recpost.title, post_path(recpost)%></span> 
                        </div>
                      </div>
                    </div>
                  </div>
              <% end %>
            <% else %>
          <p>Menus>My page>プロフィール編集で好きなカテゴリーを登録すると<%= current_user.name %>さんが気に入りそうな観光地がピックアップされます！</p>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
      
    </div>
  </div>
</div>
 <% end %>

<%= javascript_pack_tag "posts/index.js" %>


<style>
#map {
  height: 400px;
  width: 1600px;
}
.gm-style-iw {
  width: 200px;
  height: 200px; 
  max-height: 250px;
  max-width: 250px
}
.gm-style img {
    max-width: 150px;
}
</style>

<script>
let map;

const display = document.getElementById('display')

  function initMap() {
    map = new google.maps.Map(document.getElementById("map"), {
      center:{lat: 35.68123620000001, lng:139.7671248},
      zoom: 3,
    });

  <% @mappin.each do |m| %>
    <% results = Geocoder.search(m.address) %>
    <% if results.present? %>
      <% @latlng = results.first.coordinates %>
      (function() {
        let marker = new google.maps.Marker({
          position:{lat: <%= @latlng[0] %>, lng: <%= @latlng[1] %>},
          map: map
        });
        postContent = 
          "<a href='/posts/<%= m.id%>'>" + "タイトル："+ "<%= m.title%>"+"<br>"+ "住所、施設名："+ "<%= m.address%>"+"<br>"+ "<img src='<%= m.image_url(:thumb)%>'>" + "</a>";

        var infowindow = new google.maps.InfoWindow({
          content: postContent,
          width: 300,
          height: 300,
          maxWidth: 400,
          maxHeight: 400,
        });


        // クリックしたときに情報ウィンドウを表示
      marker.addListener('click', function() {
      infowindow.open(map, marker);
      });
  })();

    <% end %>
  <% end %>
  }
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['API_KEY'] %>&callback=initMap" async defer></script>
</div>
